# Copy to .env and fill in. Never commit .env.
APP_ENV=local                      # local | staging | production
LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/moin_chatbot
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
LLM_PROVIDER=openai                # openai | claude
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
EMBEDDING_MODEL=
RAG_TOP_K=5
RAG_MIN_SCORE=0.0
EMAIL_BACKEND=smtp                 # smtp | api
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
LEAD_NOTIFY_TO=info@moinsystemsai.com
